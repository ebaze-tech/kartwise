import 'package:flutter/material.dart';

void main() => runApp(const MyApp());

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      home: Scaffold(
        body: Center(child: MyCustomForm()),
      ),
    );
  }
}

class MyCustomForm extends StatefulWidget {
  const MyCustomForm({super.key});

  @override
  MyCustomFormState createState() => MyCustomFormState();
}

class MyCustomFormState extends State<MyCustomForm> {
  // 1. Create a GlobalKey to uniquely identify and track your FormState
  final _formKey = GlobalKey<FormState>();

  // Variables to hold your validated input data
  String _userEmail = '';
  String _userPassword = '';

  @override
  Widget build(BuildContext context) {
    // 2. Wrap your layout structure inside the Form widget using your key
    return Form(
      key: _formKey,
      child: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          children: <Widget>[
            // 3. Add a TextFormField for the email address
            TextFormField(
              keyboardType: TextInputType.emailAddress,
              decoration: const InputDecoration(labelText: 'Email Address'),
              validator: (value) {
                if (value == null || value.isEmpty) {
                  return 'Please enter your email';
                }
                if (!value.contains('@')) {
                  return 'Please enter a valid email';
                }
                return null; // Return null if the input is perfectly valid
              },
              onSaved: (value) => _userEmail = value ?? '',
            ),
            const SizedBox(height: 16),
            
            // 4. Add a TextFormField for the password
            TextFormField(
              obscureText: true, // Hides password characters
              decoration: const InputDecoration(labelText: 'Password'),
              validator: (value) {
                if (value == null || value.length < 6) {
                  return 'Password must be at least 6 characters long';
                }
                return null;
              },
              onSaved: (value) => _userPassword = value ?? '',
            ),
            const SizedBox(height: 24),
            
            // 5. Submit button to trigger validation and processing
            ElevatedButton(
              onPressed: () {
                // Check if all fields satisfy their specific validation criteria
                if (_formKey.currentState!.validate()) {
                  // Saves the current value to each individual form field state variable
                  _formKey.currentState!.save();
                  
                  // Process your clean data (e.g., API call, local authentication)
                  ScaffoldMessenger.of(context).showSnackBar(
                    SnackBar(content: Text('Processing login for $_userEmail')),
                  );
                }
              },
              child: const Text('Submit'),
            ),
          ],
        ),
      ),
    );
  }
}
